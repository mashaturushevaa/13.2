rule "Healthcare Stream Processing"
when
    Item Patient_HeartRate changed or
    Item Patient_SpO2 changed
then
    // 1. Симуляція аналізу потоку (Thresholds)
    val heartRate = Patient_HeartRate.state as Number
    val spo2 = Patient_SpO2.state as Number

    // 2. Complex Event Processing (CEP) - комбінація симптомів
    if (heartRate > 120 && spo2 < 90) {
        // КРИТИЧНА ПОДІЯ: Тахікардія + Гіпоксія
        Patient_Status.postUpdate("КРИТИЧНИЙ (Тахікардія + Гіпоксія)")
        Alert_Priority.postUpdate("HIGH (Red)")
        Emergency_Alarm.sendCommand(ON)
    } 
    else if (heartRate > 100 || spo2 < 94) {
        // ПОПЕРЕДЖЕННЯ
        Patient_Status.postUpdate("Увага: Відхилення")
        Alert_Priority.postUpdate("MEDIUM (Yellow)")
        Emergency_Alarm.sendCommand(OFF)
    } 
    else {
        // НОРМА
        Patient_Status.postUpdate("Стабільний")
        Alert_Priority.postUpdate("LOW (Green)")
        Emergency_Alarm.sendCommand(OFF)
    }

    logInfo("Healthcare", "CEP Аналіз: Пульс=" + heartRate + ", Кисень=" + spo2 + " -> " + Patient_Status.state)
end

// Правило для симуляції життєвих показників (щохвилини)
rule "Patient Data Simulation"
when
    Time cron "0 * * * * ?"
then
    // Рандомні дані з можливістю "критичного" випадку
    Patient_HeartRate.postUpdate(70 + (Math::random * 60).intValue)
    Patient_SpO2.postUpdate(88 + (Math::random * 12).intValue)
    Patient_Temp.postUpdate(36.6 + (Math::random * 2.0))
end